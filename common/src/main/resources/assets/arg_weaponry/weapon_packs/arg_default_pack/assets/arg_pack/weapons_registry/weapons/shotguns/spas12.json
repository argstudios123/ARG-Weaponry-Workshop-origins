  // Staged (shell-by-shell) reload.
  //   stage       prepare | initial_load | repeat_load | finish | chamber_load  ("phase" is the legacy spelling)
  //   insert_at   optional point inside the clip, in seconds, at which the shells are inserted.
  //               Omitted = the end of the clip, which is when a shell is seated.
  //   shell_amount_reload  (top level) rounds inserted per initial_load/repeat_load cycle; clamped to the room left
  //               in the magazine and to the reserve ammunition the player owns.
  //   The repeat_load clip is played once per cycle until the magazine is full or the reserve runs out.
  //   NOTE: "anim.model.load_first" and "anim.model.chamber_load" must exist in spas12.animation.json before the
  //   first shell and the chamber round animate; without them the reload still works and the stage is simply silent.
  "reload_sequences": [
    {
      "stage": "prepare",
      "animation": "anim.model.reload_start_empty",
      "duration": 0.42,
      "when": "ammo_count == -1"
    },
    {
      "stage": "prepare",
      "animation": "anim.model.reload_start",
      "duration": 0.42,
      "when": "ammo_count >= 0"
    },
    {
      "stage": "initial_load",
      "animation": "anim.model.load_first",
      "duration": 1.5,
      "when": "reload_inserted_count == 0"
    },
    {
      "stage": "repeat_load",
      "animation": "anim.model.reload_loop",
      "duration": 0.75,
      "repeat": true,
      "when": "reload_inserted_count > 0"
    },
    {
      "stage": "finish",
      "animation": "anim.model.reload_finish",
      "duration": 0.75,
      "when": "reload_inserted_count >= 0"
    }
  ]

}