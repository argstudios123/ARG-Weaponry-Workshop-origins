  "weapon_id": "arg_weaponry:dev_m100_dmr",
  "type": "gun",
  "ammo_to_use": ["dmr_ammo"],
  "display": "arg_pack:weapons/dmrs/m100_dmr/m100_dmr",
  "damage": 6,
  "ammo_capacity": 20,
  "rpm": 300
}

